{
      "cli": {
            "version": ">= 13.0.0",
            "appVersionSource": "remote"
      },
      "build": {
            "development": {
                  "developmentClient": true,
                  "distribution": "internal",
                  "android": {
                        "buildType": "apk"
                  }
            },
            "preview": {
                  "distribution": "internal",
                  "android": {
                        "buildType": "apk"
                  },
                  "ios": {
                        "simulator": false
                  },
                  "channel": "preview"
            },
            "staging": {
                  "distribution": "store",
                  "autoIncrement": true,
                  "channel": "staging",
                  "ios": {
                        "simulator": false
                  }
            },
            "production": {
                  "autoIncrement": true,
                  "channel": "production"
            }
      },
      "submit": {
            "staging": {
                  "ios": {
                        "appleId": "ahmetbehcettaylan@gmail.com",
                        "ascAppId": "6806612758"
                  },
                  "android": {
                        "track": "internal"
                  }
            },
            "production": {
                  "ios": {
                        "appleId": "ahmetbehcettaylan@gmail.com",
                        "ascAppId": "6806612758"
                  },
                  "android": {
                        "track": "production"
                  }
            }
      }
}
