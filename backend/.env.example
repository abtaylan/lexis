DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Supabase — https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# URL'ler — iyzico callback ve frontend yönlendirmeleri
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# iyzico — Abonelik (Subscription API v2)
# https://merchant.iyzipay.com (canlı) / https://sandbox-merchant.iyzipay.com (test)
# Abonelik > Ürün ve Ödeme Planları'ndan oluşturduğun plan referans kodlarını gir
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MONTHLY_PLAN_REF=
IYZICO_YEARLY_PLAN_REF=
PREMIUM_MONTHLY_PRICE=49.99
PREMIUM_YEARLY_PRICE=449.99

# ── Mobil Apple/Google IAP — web'de iyzico kalıyor, mobilde store kuralları
# gereği native IAP kullanılıyor. Aşağıdakiler doldurulana kadar mobil
# satın alma doğrulaması "yapılandırılmadı" hatası döner (asla sessizce
# premium vermez) — bkz. app/services/apple_appstore.py / google_play.py.
APPLE_BUNDLE_ID=app.lexis.mobile
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=
APPLE_USE_SANDBOX=false
GOOGLE_PLAY_PACKAGE_NAME=app.lexis.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
IAP_PRODUCT_MONTHLY=app.lexis.mobile.premium.monthly
IAP_PRODUCT_YEARLY=app.lexis.mobile.premium.yearly

# Çok dilli sözlük — MyMemory çeviri (opsiyonel e-posta, ücretsiz limiti yükseltir)
MYMEMORY_EMAIL=

# ── OTP doğrulama (giriş + kayıt sonrası) ──────────────────────
# fixed = test/geliştirme: kod her zaman 123456, mail atılmaz (log'a yazılır)
# real  = production: rastgele 6 haneli kod üretilir, SMTP ile e-postaya gönderilir
OTP_MODE=fixed
OTP_FIXED_CODE=123456
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP — production'da OTP e-postası göndermek için (Gmail App Password)
# Gmail hesabı > Google Hesabım > Güvenlik > Uygulama Şifreleri'nden 16 haneli
# bir "app password" oluştur, normal Gmail şifreni DEĞİL bunu kullan.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Lexis

# ── Sosyal medya günlük içerik paylaşımı (Madde 3b, revize) ────
# fixed = test/geliştirme: hiçbir yere gerçekten paylaşılmaz, sadece log'a yazılır
# real  = production: Telegram Bot API + Slack webhook'a gerçekten gönderilir
SOCIAL_POST_MODE=fixed
# @BotFather'dan alınan bot token'ı
TELEGRAM_BOT_TOKEN=
# Paylaşımın yapılacağı kanal/grup — örn. @lexis_kelime ya da -1001234567890
TELEGRAM_CHANNEL_ID=
# Slack workspace'inde eklediğin Incoming Webhook uygulamasının URL'i
SLACK_WEBHOOK_URL=
