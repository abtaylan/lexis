DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Supabase — https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# URL'ler — iyzico callback ve frontend yönlendirmeleri
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# iyzico — Abonelik (Subscription API v2)
# https://merchant.iyzipay.com (canlı) / https://sandbox-merchant.iyzipay.com (test)
# Abonelik > Ürün ve Ödeme Planları'ndan oluşturduğun plan referans kodlarını gir
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_MONTHLY_PLAN_REF=
IYZICO_YEARLY_PLAN_REF=
PREMIUM_MONTHLY_PRICE=49.99
PREMIUM_YEARLY_PRICE=449.99

# Çok dilli sözlük — MyMemory çeviri (opsiyonel e-posta, ücretsiz limiti yükseltir)
MYMEMORY_EMAIL=
